# ---- Database ----
# Local development (SQLite file stored in prisma/dev.db)
DATABASE_URL="file:./dev.db"
# Production PostgreSQL example (also change provider in prisma/schema.prisma — see README)
# DATABASE_URL="postgresql://user:password@host:5432/mumbaicabs?schema=public"

# ---- Site ----
# Public URL of the site (used for sitemap, Open Graph, email links)
APP_URL="http://localhost:3000"

# ---- First admin user (created by `npm run db:seed`) ----
ADMIN_EMAIL="admin@yourdomain.com"
ADMIN_PASSWORD="ChangeMe@123"
ADMIN_NAME="Admin"

# ---- Email (optional) ----
# Leave SMTP_HOST empty to print emails to the terminal instead of sending.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Bookings <info@yourdomain.com>"
# Where new-booking alerts are sent (defaults to the business email in Settings)
ADMIN_NOTIFY_EMAIL=""

# Secret code new admins must enter on /admin/signup (leave empty to disable admin sign-up)
ADMIN_SIGNUP_CODE=""
